<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:woker.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="LlmTemplate" x:DataType="models:LlmConfig">
            <Grid Padding="12,10" ColumnSpacing="10"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE945;" FontSize="14" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" />
                        <Border Padding="6,1" CornerRadius="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind DefaultVisibility}">
                            <TextBlock Text="默认" FontSize="10" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="11" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind ModelName}" /><Run Text=" · " /><Run Text="{x:Bind BaseUrl}" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="编辑" FontSize="11" Padding="10,4"
                        Click="OnEditConfig" Tag="{x:Bind Id}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="设为默认" FontSize="11" Padding="10,4"
                        Click="OnSetDefault" Tag="{x:Bind Id}" VerticalAlignment="Center" />
                <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Padding="4"
                        Click="OnDeleteConfig" Tag="{x:Bind Id}" ToolTipService.ToolTip="删除">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UpdateLogTemplate" x:DataType="models:UpdateLogEntry">
            <Expander HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,4">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" FontSize="13" />
                        <Border Padding="6,1" CornerRadius="8"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind Date}" FontSize="10" Foreground="White" />
                        </Border>
                        <TextBlock Text="{x:Bind Title}" FontSize="12" Opacity="0.8" />
                    </StackPanel>
                </Expander.Header>
                <TextBlock Text="{x:Bind ChangesText}" TextWrapping="Wrap" FontSize="12" LineHeight="22" />
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="20,8,20,20">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <StackPanel Spacing="2">
                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="服务器地址 · 大模型接入 · 更新日志"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 服务器配置 -->
            <Border CornerRadius="10" Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock Text="后端服务器" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="服务器地址" FontSize="12" Opacity="0.8" />
                            <TextBox x:Name="SrvUrl" PlaceholderText="请输入服务器地址，例如 https://api.example.com" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Click="OnTestServer" Content="测试连接" />
                        <Button Click="OnSaveServer" Style="{StaticResource AccentButtonStyle}" Content="保存配置" />
                        <ProgressRing x:Name="ServerRing" IsActive="False" Width="22" Height="22" />
                        <TextBlock x:Name="ServerStatus" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="提示：数据全部通过该服务器提供的后端接口读写，不再直连数据库。修改地址后点击「保存配置」立即生效。"
                               FontSize="11" Opacity="0.6"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 大模型配置 -->
            <Border CornerRadius="10" Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="14" />
                            <TextBlock Text="大模型配置（OpenAI 兼容协议）" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Click="OnAddPreset" Content="从预置添加" />
                            <Button Click="OnAddConfig" Style="{StaticResource AccentButtonStyle}" Content="自定义接入" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="LlmList" ItemTemplate="{StaticResource LlmTemplate}" SelectionMode="None" />
                    <StackPanel x:Name="LlmEmpty" Padding="20" Spacing="6" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE945;" FontSize="24" Opacity="0.5" HorizontalAlignment="Center" />
                        <TextBlock Text="尚未接入大模型。可「从预置添加」DeepSeek / 通义千问 / Kimi / 智谱，或「自定义接入」任意 OpenAI 兼容服务。"
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="应用更新" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="AppVersionText" />
                    <TextBox x:Name="UpdateRepositoryBox" Header="GitHub 发布仓库" PlaceholderText="用户名/仓库名" />
                    <CheckBox x:Name="CheckUpdatesOnStartup" Content="启动时检查新版本" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="保存更新设置" Click="OnSaveUpdateSettings" />
                        <Button x:Name="CheckUpdateButton" Content="检查更新" Click="OnCheckUpdate" />
                    </StackPanel>
                    <TextBlock Text="从公开的 GitHub Releases 获取正式版本，确认后下载安装。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 更新日志 -->
            <Border CornerRadius="10" Padding="16" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                        <TextBlock Text="更新日志" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                    <ListView x:Name="UpdateLogList" ItemTemplate="{StaticResource UpdateLogTemplate}" SelectionMode="None" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
