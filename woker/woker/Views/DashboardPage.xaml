<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:woker.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TaskTemplate" x:DataType="models:WorkTask">
            <Grid Padding="12,10" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsDone}"
                          Checked="OnTaskToggle" Unchecked="OnTaskToggle" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{x:Bind Result}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="2" Padding="8,3" CornerRadius="10" VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind Type}" FontSize="11" />
                </Border>
                <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center" MinWidth="36"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind CostHours}" /><Run Text="h" />
                </TextBlock>
                <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Padding="4"
                        Click="OnDeleteTask" Tag="{x:Bind Id}" ToolTipService.ToolTip="删除">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="20,8,20,20">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- 模块头 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="01 · 今日工作成果" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="以数据、结果为导向，量化记录当日核心工作与产出"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAddTask">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="新增成果" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- KPI 卡片 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="16" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SExec" Text="0" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="执行用例" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SPass" Text="0" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="用例通过" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SBug" Text="0" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="发现缺陷" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="16" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SRate" Text="0%" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="回归通过率" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="16" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SHours" Text="0h" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="有效工时" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 任务列表 -->
            <Border CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Padding="14,10" ColumnSpacing="12"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text=" " />
                        <TextBlock Grid.Column="1" Text="任务 / 产出" FontSize="12" Opacity="0.7" />
                        <TextBlock Grid.Column="2" Text="类型" FontSize="12" Opacity="0.7" MinWidth="60" />
                        <TextBlock Grid.Column="3" Text="耗时" FontSize="12" Opacity="0.7" MinWidth="36" />
                        <TextBlock Grid.Column="4" Text="  " />
                    </Grid>
                    <ListView x:Name="TaskList" ItemTemplate="{StaticResource TaskTemplate}"
                              SelectionMode="None" IsItemClickEnabled="False" />
                    <StackPanel x:Name="EmptyState" Padding="24" Spacing="8" HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7B3;" FontSize="28" Opacity="0.5" HorizontalAlignment="Center" />
                        <TextBlock Text="今日暂无成果记录，点击右上角「新增成果」开始沉淀。"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
