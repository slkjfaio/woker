<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.AiChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20,8,20,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：模型选择 + 快捷操作 -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="AI 助手" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="自由对话 · 润色日报 · 生成总结素材，支持自定义接入 OpenAI 兼容大模型"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ComboBox x:Name="ModelBox" MinWidth="180"
                          ToolTipService.ToolTip="选择大模型（在设置页管理）" SelectionChanged="OnModelChanged" />
                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnPolishDaily" Content="润色今日日报" />
                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnClearChat" Content="清空对话" />
            </StackPanel>
        </Grid>

        <!-- 对话区 -->
        <Border Grid.Row="1" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer x:Name="ChatScroll" Padding="14">
                <StackPanel x:Name="ChatPanel" Spacing="10" />
            </ScrollViewer>
        </Border>

        <!-- 输入区 -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" PlaceholderText="输入消息，Enter 发送，Shift+Enter 换行…"
                     TextWrapping="Wrap" MinHeight="52" MaxHeight="140" AcceptsReturn="True" />
            <Button Grid.Column="1" x:Name="SendBtn" Style="{StaticResource AccentButtonStyle}"
                    Click="OnSend" VerticalAlignment="Stretch" MinWidth="96">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="13" />
                    <TextBlock x:Name="SendText" Text="发送" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>