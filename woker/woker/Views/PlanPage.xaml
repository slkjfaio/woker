<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.PlanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:woker.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="PlanTemplate" x:DataType="models:PlanItem">
            <Border Padding="12,10" CornerRadius="8" Margin="0,0,0,8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE823;" FontSize="11" Opacity="0.6" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind EstHours}" /><Run Text="h" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="2"
                                Click="OnDeletePlan" Tag="{x:Bind Id}" ToolTipService.ToolTip="删除">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind Note}" FontSize="11" TextWrapping="Wrap" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind NoteVisibility}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="20,8,20,20">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="05 · 次日优先级计划" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="紧急优先 · 常规迭代 · 能力提升 三类事项，有序推进"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAddPlanTop">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="新增计划" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 紧急优先 -->
                <Border CornerRadius="10" Padding="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="紧急优先" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="4" HorizontalAlignment="Right"
                                    Click="OnAddPlan0" ToolTipService.ToolTip="添加紧急事项">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="Count0" FontSize="11" Opacity="0.6" />
                        <ListView x:Name="List0" ItemTemplate="{StaticResource PlanTemplate}" SelectionMode="None" />
                    </StackPanel>
                </Border>

                <!-- 常规迭代 -->
                <Border Grid.Column="1" CornerRadius="10" Padding="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="常规迭代" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="4" HorizontalAlignment="Right"
                                    Click="OnAddPlan1" ToolTipService.ToolTip="添加常规迭代">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="Count1" FontSize="11" Opacity="0.6" />
                        <ListView x:Name="List1" ItemTemplate="{StaticResource PlanTemplate}" SelectionMode="None" />
                    </StackPanel>
                </Border>

                <!-- 能力提升 -->
                <Border Grid.Column="2" CornerRadius="10" Padding="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="能力提升" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="4" HorizontalAlignment="Right"
                                    Click="OnAddPlan2" ToolTipService.ToolTip="添加能力提升">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="Count2" FontSize="11" Opacity="0.6" />
                        <ListView x:Name="List2" ItemTemplate="{StaticResource PlanTemplate}" SelectionMode="None" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
