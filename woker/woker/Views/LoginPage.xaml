<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- 背景装饰圆 -->
        <Ellipse Width="420" Height="420" Margin="-160,-120,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.06" />
        <Ellipse Width="520" Height="520" Margin="0,0,-200,-220"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.05" />

        <!-- 登录卡片 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border MaxWidth="440" Margin="24" Padding="36,32" CornerRadius="16" VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <!-- 品牌区 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                   Width="44" Height="44" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="工作日志工作台" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="QA · WorkBench" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="HeaderTitle" Text="登录工作台" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock x:Name="HeaderSub" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="使用账号密码登录，数据保存在后端服务器" />

                    <!-- 错误提示 -->
                    <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="False" />

                    <!-- 注册额外字段 -->
                    <StackPanel x:Name="RegExtraPanel" Spacing="10" Visibility="Collapsed">
                        <TextBox x:Name="RegNameBox" Header="昵称" PlaceholderText="显示名称（可留空）" />
                        <TextBox x:Name="RegMailBox" Header="邮箱" PlaceholderText="example@company.com（可留空）" />
                    </StackPanel>

                    <TextBox x:Name="ServerUrlBox" Header="服务器地址" PlaceholderText="例如 https://api.example.com" />
                    <TextBox x:Name="UserBox" Header="用户名" PlaceholderText="用户名" />
                    <PasswordBox x:Name="PassBox" Header="密码" PlaceholderText="密码"
                                 PasswordRevealMode="Peek" />

                    <PasswordBox x:Name="RegConfirmPassBox" Header="确认密码"
                                 PlaceholderText="请再次输入密码" PasswordRevealMode="Peek"
                                 Visibility="Collapsed" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="安全验证码" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CaptchaAnswerBox" PlaceholderText="请输入验证码或计算结果" />
                            <Button Grid.Column="1" Width="116" Height="40" Padding="0"
                                    ToolTipService.ToolTip="点击刷新验证码" Click="OnRefreshCaptcha">
                                <Image x:Name="CaptchaImage" Width="116" Height="40" Stretch="Uniform" />
                            </Button>
                            <Button Grid.Column="2" Width="40" Height="40" Padding="0"
                                    ToolTipService.ToolTip="刷新验证码" Click="OnRefreshCaptcha">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <CheckBox x:Name="RememberCheck" Content="保持登录状态" IsChecked="True" />

                    <Button x:Name="SubmitBtn" Style="{StaticResource AccentButtonStyle}"
                            Height="40" HorizontalAlignment="Stretch"
                            Click="OnSubmitClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="SubmitIcon" Glyph="&#xE8AF;" FontSize="14" />
                            <TextBlock x:Name="SubmitText" Text="登录" />
                        </StackPanel>
                    </Button>

                    <HyperlinkButton x:Name="ModeSwitch" HorizontalAlignment="Center"
                                     Content="没有账号？去注册" Click="OnSwitchMode" />

                    <ProgressRing x:Name="LoadingRing" IsActive="False" Width="28" Height="28"
                                  HorizontalAlignment="Center" />

                    <TextBlock Text="数据云端同步 · 支持账号密码登录"
                               FontSize="11" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
