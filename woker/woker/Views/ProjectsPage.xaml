<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:woker.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8F1;" FontSize="20" />
                <TextBlock Text="项目管理" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <Button Content="新建项目" Click="OnAddProject" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>

        <!-- 项目列表 -->
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater x:Name="ProjectList" ItemsSource="{x:Bind Projects}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:Project">
                        <Border Margin="0,0,0,12" Padding="20" CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 项目图标 -->
                                <Border Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top">
                                    <Border.Background>
                                        <SolidColorBrush Color="{x:Bind Color}" Opacity="0.15" />
                                    </Border.Background>
                                    <FontIcon Glyph="&#xE8F1;" FontSize="20">
                                        <FontIcon.Foreground>
                                            <SolidColorBrush Color="{x:Bind Color}" />
                                        </FontIcon.Foreground>
                                    </FontIcon>
                                </Border>

                                <!-- 项目信息 -->
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" />
                                        <Border Padding="8,2" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                Visibility="{x:Bind DefaultBadgeVisibility}">
                                            <TextBlock Text="默认" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                        <Run Text="创建于" />
                                        <Run Text="{x:Bind CreatedAt}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="编辑" Style="{StaticResource SubtleButtonStyle}"
                                            Click="OnEditProject" Tag="{x:Bind Id}">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="E" Modifiers="Control" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                    <Button Style="{StaticResource SubtleButtonStyle}" Click="OnMoreOptions" Tag="{x:Bind Id}">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="设为默认" Click="OnSetDefault" Tag="{x:Bind Id}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE735;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="归档项目" Click="OnArchiveProject" Tag="{x:Bind Id}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE7B8;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- 空状态提示 -->
        <StackPanel Grid.Row="1" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneTime}">
            <FontIcon Glyph="&#xE8F1;" FontSize="64" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="还没有项目" FontSize="18" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="创建第一个项目" Click="OnAddProject" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
