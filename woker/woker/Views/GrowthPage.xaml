<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.GrowthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:woker.Models"
    xmlns:views="using:woker.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="GrowthTemplate" x:DataType="models:GrowthEntry">
            <Grid Padding="12,10" ColumnSpacing="10"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="{x:Bind DimName}" FontSize="11" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock FontSize="11" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="{x:Bind DimName}" /><Run Text=" · " /><Run Text="{x:Bind TimeStr}" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="4"
                        Click="OnDeleteGrowth" Tag="{x:Bind Id}" ToolTipService.ToolTip="删除">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="20,8,20,20">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="03 · 当日能力成长" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="业务认知 · 测试思维 · 问题排查 · 工具技能 · 沟通协作 五大维度增量"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAddGrowth">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="记录成长" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- 左：概览 + 五维条 -->
                <StackPanel Spacing="12">
                    <Border Padding="16" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="今日成长条目" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="GrowthCount" Text="0" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="5 个维度持续累积" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                        <StackPanel x:Name="DimBars" Spacing="12" />
                    </Border>
                </StackPanel>

                <!-- 右：成长记录 -->
                <Border Grid.Column="1" Padding="14" CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="成长增量记录" FontSize="14" FontWeight="SemiBold" />
                            <Border HorizontalAlignment="Right" Padding="8,2" CornerRadius="10"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="GrowthWeek" Text="本周 +0" FontSize="11" />
                            </Border>
                        </Grid>
                        <ListView x:Name="GrowthList" ItemTemplate="{StaticResource GrowthTemplate}"
                                  SelectionMode="None" />
                        <StackPanel x:Name="EmptyState" Padding="20" Spacing="8" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE7B3;" FontSize="26" Opacity="0.5" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无成长记录，沉淀每一个微小进步。" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
