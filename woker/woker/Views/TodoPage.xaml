<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.TodoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:woker.Models"
    xmlns:views="using:woker.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="TodoTemplate" x:DataType="models:TodoItem">
            <Grid Padding="12,10" ColumnSpacing="10"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsDone}"
                          Checked="OnTodoToggle" Unchecked="OnTodoToggle" />
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" FontSize="13"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Padding="8,2" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind PriorityText}" FontSize="11" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE823;" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{x:Bind Deadline}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Padding="8,2" CornerRadius="10"
                            Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                            Visibility="{x:Bind MetaVisibility}">
                        <TextBlock Text="{x:Bind Meta}" FontSize="11" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Padding="4"
                        Click="OnDeleteTodo" Tag="{x:Bind Id}" ToolTipService.ToolTip="删除">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="20,8,20,20">
        <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="04 · 遗留待办" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="未完成任务 · 待复测缺陷 · 待输出文档 · 待对接事项，闭环可控"
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAddTodo">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="新增待办" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border CornerRadius="10" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <SelectorBar x:Name="CatBar" Padding="12,10" SelectionChanged="OnCatChanged" />
                    <ListView x:Name="TodoList" ItemTemplate="{StaticResource TodoTemplate}"
                              SelectionMode="None" />
                    <Grid Padding="14,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          CornerRadius="0,0,10,10">
                        <TextBlock x:Name="FootTotal" FontSize="12" />
                        <TextBlock x:Name="FootUndone" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
