<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="woker.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        OpenPaneLength="236"
                        SelectionChanged="OnNavSelectionChanged"
                        IsPaneToggleButtonVisible="True"
                        IsSettingsVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" Content="今日工作成果">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEC47;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="reflection" Content="问题复盘与解决">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="growth" Content="当日能力成长">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="todo" Content="遗留待办">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73A;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="plan" Content="次日优先级计划">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="summary" Content="周/转正总结素材">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="projects" Content="项目管理">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="ai" Content="AI 助手">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="export" Content="导出 Markdown 闭环" SelectsOnInvoked="False"
                                    Tapped="OnExportTapped">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Grid Padding="16,10,16,8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                ToolTipService.ToolTip="WorkBench">
                            <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                   Width="28" Height="28" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="今日工作成果" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="首页 / 工作日志 / " /><Run x:Name="PageCrumb" Text="今日台账" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Padding="10,5" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="12" />
                                <TextBlock x:Name="ChipDate" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Padding="10,5" CornerRadius="14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9F4;" FontSize="12" />
                                <TextBlock x:Name="ChipWeek" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ComboBox x:Name="ProjectBox" MinWidth="170" FontSize="12"

                                  SelectionChanged="OnProjectChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ThemeBtn" Style="{StaticResource SubtleButtonStyle}"
                                Click="OnToggleTheme" ToolTipService.ToolTip="切换深浅主题">
                            <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="14" />
                        </Button>
                        <Button x:Name="UserBtn" Style="{StaticResource SubtleButtonStyle}" Click="OnUserMenu">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="26" Height="26" CornerRadius="13"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock x:Name="AvatarText" Text="测" FontSize="12" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="UserNameText" Text="—" FontSize="12" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="UserFlyout" Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="UserInfoItem" IsEnabled="False" Text="—" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="退出登录" Click="OnLogout">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF3B1;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 内容区 -->
                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- Toast 通知 -->
        <InfoBar x:Name="ToastBar" IsOpen="False" Severity="Success" IsClosable="True"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                 MaxWidth="360" />
    </Grid>
</Page>
