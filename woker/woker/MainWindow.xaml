<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="woker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:woker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="工作日志工作台 · WorkBench">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="UpdateNotice" IsOpen="False" Severity="Informational" Title="发现新版本">
                <InfoBar.ActionButton>
                    <Button Content="查看更新" Click="OnOpenUpdate" />
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- 启动/连接视图 -->
            <Grid x:Name="BootView" Grid.Row="1" Visibility="Visible">
                <Border MaxWidth="460" Padding="36,32" CornerRadius="16" VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="10"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png"
                                       Width="44" Height="44" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="工作日志工作台" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="QA · WorkBench" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
<TextBlock x:Name="BootText" Text="正在连接服务器…" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        <ProgressRing x:Name="BootRing" IsActive="True" Width="32" Height="32"
                                      HorizontalAlignment="Center" />
                        <TextBlock x:Name="BootError" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <Button x:Name="RetryBtn" Content="重试连接" HorizontalAlignment="Center"
                                Visibility="Collapsed" Click="OnRetry" />
                        <Button Content="修改服务器地址 / 登录" HorizontalAlignment="Center" Click="OnConfigureServer" />
                        <TextBlock x:Name="BootHint" Text="请确认网络可用，或在「设置 → 服务器地址」中修改后端服务器地址。"
                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 主内容 -->
            <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
